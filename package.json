{
  "name": "lifeqr",
  "version": "1.0.0",
  "description": "Emergency Medical QR Code System",
  "main": "backend/server.js",
  "scripts": {
    "start": "npm --prefix backend start",
    "dev": "npm --prefix backend run dev",
    "install-all": "npm --prefix backend install",
    "sync": "node scripts/sync-frontend.js",
    "sync:watch": "node scripts/sync-frontend.js --watch",
    "build-css": "node scripts/sync-frontend.js && npx tailwindcss -i ./website/src/input.css -o ./website/dist/output.css --minify && node scripts/sync-frontend.js"
  },
  "keywords": [
    "medical",
    "emergency",
    "qr-code",
    "healthcare"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=16.0.0"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.1"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "nodemailer": "^10.1.0",
    "puppeteer-core": "^25.12.0"
  }
}
