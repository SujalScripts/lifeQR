<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <RelativeLayout
        android:id="@+id/splashContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="visible">

        <!-- 1080x1920 9:16 Cinematic LifeQR Logo Studio Reference (Locked 50% x 50%) -->
        <ImageView
            android:id="@+id/splashCinematicView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/lifeqr_splash_cinematic"
            android:contentDescription="LifeQR Cinematic Intro" />

        <!-- Soft Illumination Overlay Layer -->
        <View
            android:id="@+id/splashLightOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FFFFFF"
            android:visibility="gone" />

    </RelativeLayout>

</RelativeLayout>
